#!/bin/bash
set -e -x

cd "$(dirname "$0")/.."

. ./scripts/version.sh
# shellcheck source=scripts/embed-static-default.sh
. ./scripts/embed-static-default.sh

GO=${GO-go}
PKG="github.com/eclipse-iofog/edgelet"
PKG_CONTAINERD="github.com/containerd/containerd/v2"
PKG_CNI_PLUGINS="github.com/containernetworking/plugins"

buildDate=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

VERSIONFLAGS="
    -X ${PKG_CONTAINERD}/version.Version=${VERSION_CONTAINERD}
    -X ${PKG_CONTAINERD}/version.Package=${PKG_CONTAINERD}
    -X ${PKG_CNI_PLUGINS}/pkg/utils/buildversion.BuildVersion=${VERSION_CNIPLUGINS}
"

LDFLAGS="-w -s"
TAGS="netcgo osusergo urfave_cli_no_docs sqlite_omit_load_extension apparmor seccomp"

if [ -n "${DEBUG}" ]; then
  GCFLAGS="-N -l"
else
  GCFLAGS=""
fi

case ${OS} in
  linux)
    ;;
  darwin)
    OS=linux
    ;;
  *)
    echo "[ERROR] unsupported OS for embed build: ${OS}" >&2
    exit 1
    ;;
esac

mkdir -p build/bin build/images
ROOT="$(pwd)"

if [ "${ARCH}" = armv7l ] || [ "${ARCH}" = arm ]; then
  export GOARCH=arm
  export GOARM=7
fi

INSTALLBIN="$(pwd)/build/bin"

# ── CNI multicall (bridge, host-local, loopback, portmap) ───────────────────
echo "Building CNI multicall (Edgelet 4-plugin set) for ${OS}/${GOARCH:-${ARCH}}"
(
  TMPDIR=$(mktemp -d)
  WORKDIR="${TMPDIR}/src/github.com/containernetworking/plugins"
  git clone --single-branch --depth=1 --branch="${VERSION_CNIPLUGINS}" \
    https://github.com/rancher/plugins.git "${WORKDIR}"
  cd "${WORKDIR}"
  rm -rf plugins/meta/flannel
  cp "${ROOT}/scripts/cni-main_linux.go.in" main_linux.go
  GO111MODULE=off GOPATH="${TMPDIR}" CGO_ENABLED=0 GOOS="${OS}" GOARCH="${GOARCH:-${ARCH}}" \
    "${GO}" build -tags "${TAGS}" -gcflags="all=${GCFLAGS}" \
    -ldflags "${VERSIONFLAGS} ${LDFLAGS}" \
    -o "${INSTALLBIN}/cni${BINARY_POSTFIX}"
)

for plugin in bridge host-local loopback portmap; do
  rm -f "${INSTALLBIN}/${plugin}${BINARY_POSTFIX}"
  ln -sf "cni${BINARY_POSTFIX}" "${INSTALLBIN}/${plugin}${BINARY_POSTFIX}"
done

# ── containerd-shim-runc-v2 ───────────────────────────────────────────────────
_SHIM_GOPATH=$(mktemp -d)
trap 'rm -rf "${_SHIM_GOPATH}"' EXIT
mkdir -p "${_SHIM_GOPATH}/src"
_HOST_GOARCH=$("${GO}" env GOARCH)
_SHIM_CC="${CC:-gcc}"
case "${ARCH}" in
  amd64)
    if [ "${_HOST_GOARCH}" != "amd64" ]; then
      _SHIM_CC="${CC:-x86_64-linux-gnu-gcc}"
    fi
    ;;
  arm64)
    if [ "${_HOST_GOARCH}" != "arm64" ]; then
      _SHIM_CC="${CC:-aarch64-linux-gnu-gcc}"
    fi
    ;;
  arm) _SHIM_CC="${CC:-arm-linux-gnueabihf-gcc}" ;;
  riscv64) _SHIM_CC="${CC:-riscv64-linux-gnu-gcc}" ;;
esac
_SHIM_LDFLAGS="${VERSIONFLAGS} ${LDFLAGS}"
if [ "${EMBED_STATIC_BUILD}" = "true" ]; then
  _SHIM_LDFLAGS="${VERSIONFLAGS} ${LDFLAGS} -extldflags '-static -lm -ldl -pthread'"
  echo "Building containerd-shim-runc-v2 static (CC=${_SHIM_CC})"
else
  echo "Building containerd-shim-runc-v2 (CC=${_SHIM_CC})"
fi
pushd ./build/src/github.com/containerd/containerd
SHIM_TAGS="${TAGS/netcgo/netgo}"
CGO_ENABLED=1 GOOS="${OS}" GOARCH="${GOARCH:-${ARCH}}" CC="${_SHIM_CC}" \
  "${GO}" build -tags "${SHIM_TAGS}" -gcflags "all=${GCFLAGS}" \
  -ldflags "${_SHIM_LDFLAGS}" \
  -o bin/containerd-shim-runc-v2 ./cmd/containerd-shim-runc-v2
popd
cp -vf ./build/src/github.com/containerd/containerd/bin/containerd-shim-runc-v2 \
  "${INSTALLBIN}/containerd-shim-runc-v2${BINARY_POSTFIX}"

# ── crun (static glibc; all arches including arm32) ───────────────────────────
if [ "$(uname -s)" != Linux ]; then
  echo "[ERROR] build-embedded crun step requires Linux; use build/Dockerfile.embedded on macOS." >&2
  exit 1
fi
chmod +x ./scripts/build-crun-static 2>/dev/null || true
INSTALLBIN="${INSTALLBIN}" ARCH="${ARCH}" ./scripts/build-crun-static

# ── pause image ───────────────────────────────────────────────────────────────
PAUSE_ARCH="${ARCH}"
case "${ARCH}" in
  arm) PAUSE_ARCH="arm/v7" ;;
esac

if ! command -v crane >/dev/null 2>&1; then
  echo "Installing crane..."
  # Host-arch tool: GOARCH may be set for cross-build (arm/riscv64 on amd64 builder).
  (
    unset GOARCH GOARM
    "${GO}" install github.com/google/go-containerregistry/cmd/crane@latest
  )
  export PATH="$("${GO}" env GOPATH)/bin:${PATH}"
fi

echo "Pulling pause image ${VERSION_PAUSE} for ${OS}/${PAUSE_ARCH}"
crane pull --platform "${OS}/${PAUSE_ARCH}" "${VERSION_PAUSE}" build/images/pause.tar
python3 ./scripts/retag-pause-archive.py build/images/pause.tar
gzip -f build/images/pause.tar

echo "Build-embedded complete: ${INSTALLBIN}"
trap - EXIT
rm -rf "${_SHIM_GOPATH}"
