# Reproducible linux CI gate for embed pipeline + edgelet build matrix.
# macOS dev:
#   docker build -f build/Dockerfile.embedded -t edgelet-embed-ci .
#   docker run --rm -v "$(pwd)":/src -w /src edgelet-embed-ci ./scripts/ci
FROM golang:1.26.10-trixie@sha256:7202554ed358a37f41c44e4910ae29bbc5ef0715f289ac637218adbb0ca132dd

COPY scripts/install-embed-build-deps /usr/local/bin/install-embed-build-deps
RUN chmod +x /usr/local/bin/install-embed-build-deps \
    && install-embed-build-deps --ci

WORKDIR /src
COPY . .

RUN chmod +x scripts/ci scripts/clean scripts/download scripts/download-root scripts/stage-root-aux \
    scripts/build-crun-static scripts/build-embedded scripts/package-data scripts/build-edgelet \
    scripts/binary_size_check.sh scripts/validate scripts/install-embed-build-deps

CMD ["./scripts/ci"]
